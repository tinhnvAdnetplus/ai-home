{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "aihome-app",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts",
        "build": "tsc --noEmit && vite build --mode production --config vite.config.ts && node scripts/verify-build.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@aihome/bdm": "workspace:*",
        "@aihome/cad-export": "workspace:*",
        "@aihome/config-schema": "workspace:*",
        "@aihome/elevation": "workspace:*",
        "@aihome/planner": "workspace:*",
        "@aihome/render3d": "workspace:*",
        "@radix-ui/react-checkbox": "1.1.4",
        "@radix-ui/react-dialog": "1.1.6",
        "@radix-ui/react-label": "2.1.2",
        "@radix-ui/react-radio-group": "1.2.3",
        "@radix-ui/react-select": "2.1.6",
        "@radix-ui/react-slot": "1.1.2",
        "@radix-ui/react-tabs": "1.1.3",
        "@tanstack/react-query": "5.104.2",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "i18next": "26.4.3",
        "lucide-react": "0.475.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-error-boundary": "6.1.6",
        "react-i18next": "17.0.16",
        "tailwind-merge": "3.0.2",
        "three": "0.186.1",
        "zod": "3.24.2"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "22.20.5",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@types/three": "0.186.0",
        "@vitejs/plugin-react": "5.2.0",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "3.8.3",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-check-file": "3.3.2",
        "eslint-plugin-i18next": "6.1.5",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsdom": "30.1.2",
        "laravel-vite-plugin": "2.1.0",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "5.7.3",
        "typescript-eslint": "8.71.1",
        "vite": "7.3.7",
        "vitest": "5.0.3",
        "vitest-axe": "0.1.0"
    }
}
