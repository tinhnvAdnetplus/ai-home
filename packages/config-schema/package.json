{
    "name": "@aihome/config-schema",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": "./src/index.ts",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "schema:generate": "tsx src/json-schema/generate-cli.ts",
        "schema:check": "tsx src/json-schema/check-cli.ts",
        "fixtures:generate": "tsx src/fixtures/generate-cli.ts",
        "fixtures:check": "tsx src/fixtures/check-cli.ts",
        "schema:verify": "tsx src/json-schema/verify-cli.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "zod": "3.24.2",
        "zod-to-json-schema": "3.24.3"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "ajv": "8.17.1",
        "eslint": "9.39.5",
        "eslint-plugin-check-file": "3.3.2",
        "fast-check": "4.10.2",
        "prettier": "3.9.10",
        "tsx": "4.19.3",
        "typescript": "5.7.3",
        "typescript-eslint": "8.71.1",
        "vitest": "5.0.3"
    }
}
